---
// Shared layout: self-hosted fonts, design tokens, meta/OG scaffold.
// Full meta/OG/structured-data parity is finalized in Stage 5; this is the base.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource-variable/fraunces/standard-italic.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** OG/social image path relative to the site root; resolved against base. */
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Ekomobong Iwatt — software engineer who ships with AI',
  description = 'Computer Engineering @ University of Lagos. I ship production-grade products, fast.',
  image = 'og-card.png',
  noindex = false,
} = Astro.props;

// Resolve absolute URLs that respect the GitHub Pages `base`.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site
  ? new URL(`${import.meta.env.BASE_URL}/${image}`.replace(/\/+/g, '/'), Astro.site).href
  : image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/+/g, '/')} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
