---
// Résumé — dark on screen, clean ink-on-white when printed (Download PDF →
// window.print()). Real content ported from the legacy cv.html. Colours use
// .cv-* helper classes (defined below) so the print stylesheet can flip the
// whole page to a professional light layout in one place.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { projects } from '../data/sections';

const base = import.meta.env.BASE_URL;

// Contact details come from site.ts so they only need updating in one place.
// Labels are the URLs without the protocol (e.g. github.com/EkomIwatt).
const bare = (url: string) => url.replace(/^https?:\/\//, '');
const contacts = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: bare(site.socials.linkedin), href: site.socials.linkedin },
  { label: bare(site.socials.github), href: site.socials.github },
  { label: site.location, href: null },
];

// Personal projects reuse the shared data (SmartPump is listed under Experience).
const cvProjects = projects.filter((p) => p.name !== 'SmartPump' && !p.wip);
const isExternal = (href: string) => /^https?:\/\//.test(href);

const languages = ['Kotlin', 'Python', 'TypeScript', 'C++', 'C', 'SQL'];
const webTools = ['Android / Compose', 'FastAPI', 'React', 'Postgres', 'Arduino', 'Claude Code', 'Docker', 'MATLAB'];
const softSkills = ['Leadership', 'Problem-Solving', 'Strong Communication', 'Financial Planning'];
---

<Base title={`Résumé — ${site.name}`} description={`Résumé of ${site.name}: Computer Engineering student at the University of Lagos. Android, embedded and full-stack development; Financial Secretary of SEES, UNILAG.`}>
  <!-- Top bar (screen only) -->
  <div class="no-print mx-auto flex max-w-4xl items-center justify-between px-6 py-6">
    <a href={base} class="font-mono text-xs uppercase tracking-[0.12em] text-muted hover:text-ink">
      <span aria-hidden="true">←</span> Back to portfolio
    </a>
    <button type="button" id="print-cv" class="btn btn-shine btn-sm">
      Download PDF <span aria-hidden="true">↓</span>
    </button>
  </div>

  <main id="main" class="cv cv-ink mx-auto max-w-4xl px-6 pb-24">
    <!-- Header -->
    <header class="cv-line flex flex-col gap-6 border-b pb-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-4xl font-semibold tracking-tight">{site.name}<span class="text-crimson">.</span></h1>
        <p class="cv-muted mt-2 text-lg">Computer Engineering Student · Android, Embedded &amp; Full-Stack</p>
      </div>
      <ul class="flex flex-col gap-1.5 font-mono text-xs">
        {contacts.map((c) => (
          <li>
            {c.href ? (
              <a href={c.href} class="cv-accent hover:underline">{c.label}</a>
            ) : (
              <span class="cv-muted">{c.label}</span>
            )}
          </li>
        ))}
      </ul>
    </header>

    <div class="mt-10 grid gap-10 md:grid-cols-3">
      <!-- Main column -->
      <div class="space-y-10 md:col-span-2">
        <section>
          <h2 class="cv-eyebrow">Profile</h2>
          <p class="cv-muted mt-3 leading-relaxed">
            Computer Engineering student at the University of Lagos, under contract as the Android
            developer on a cashless fuel-pump system (Kotlin app + Arduino firmware). Alongside it,
            four full-stack apps shipped in four months, backed by 1,800+ automated tests across
            all builds. Elected Financial Secretary of SEES and Class Representative since first year.
          </p>
        </section>

        <section>
          <h2 class="cv-eyebrow">Experience &amp; Leadership</h2>
          <div class="mt-4 space-y-6">
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-semibold">Android Developer (Contract)</h3>
                <span class="cv-faint shrink-0 font-mono text-xs">Apr 2026 – Present</span>
              </div>
              <p class="cv-accent text-sm">Balanceè Tech Solutions Ltd — Lagos</p>
              <ul class="cv-muted mt-2 list-disc space-y-1 pl-5 text-sm">
                <li>Sole developer of SmartPump: an Android kiosk app (Kotlin, Jetpack Compose, Hilt, Room) that turns fuel dispensers into self-service, cashless pumps across four transaction flows.</li>
                <li>Designed a checksummed USB-serial protocol and wrote the Arduino firmware for pulse counting and relay control; fuel cuts off on the exact pulse paid for, holding through 5 forced app crashes on the bench.</li>
                <li>Integrated Paystack QR payments and an HMAC-signed REST API; validated the full paid lifecycle with a real sale on production. Pre-launch.</li>
                <li>600+ automated tests (unit, migration, on-device); delivered in 11 review-gated phases.</li>
              </ul>
            </div>
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-semibold">Financial Secretary (elected)</h3>
                <span class="cv-faint shrink-0 font-mono text-xs">2025 – Present</span>
              </div>
              <p class="cv-accent text-sm">SEES (Society of Electrical &amp; Electronics Engineering Students) — UNILAG</p>
              <ul class="cv-muted mt-2 list-disc space-y-1 pl-5 text-sm">
                <li>Own the society's budgets, records, dues collection and financial reporting.</li>
                <li>Finance a six-programme annual portfolio, including the SEES Conference.</li>
                <li>Lead corporate sponsorship outreach: proposals and pitch decks to national brands.</li>
              </ul>
            </div>
            <div>
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-semibold">Class Representative</h3>
                <span class="cv-faint shrink-0 font-mono text-xs">2023 – Present</span>
              </div>
              <p class="cv-accent text-sm">Dept. of Computer Engineering — UNILAG</p>
              <ul class="cv-muted mt-2 list-disc space-y-1 pl-5 text-sm">
                <li>Represent 100+ students as liaison between faculty and students.</li>
                <li>Ensure academic and welfare concerns are met efficiently.</li>
                <li>Coordinate class activities, schedules, and academic support sessions.</li>
              </ul>
            </div>
          </div>
        </section>

        <section>
          <h2 class="cv-eyebrow">Technical Projects</h2>
          <div class="mt-4 space-y-5">
            {cvProjects.map((p) => (
              <div>
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-semibold">{p.name}</h3>
                  {isExternal(p.href) && (
                    <a href={p.href} class="cv-accent shrink-0 font-mono text-xs hover:underline">{p.cta ?? 'View'} ↗</a>
                  )}
                </div>
                <p class="cv-muted mt-1 text-sm">{p.blurb}</p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <div class="space-y-10">
        <section>
          <h2 class="cv-eyebrow">Education</h2>
          <div class="mt-3">
            <h3 class="font-semibold">University of Lagos</h3>
            <p class="cv-muted text-sm">B.Sc. Computer Engineering</p>
            <p class="cv-accent mt-1 font-mono text-xs">2023 – 2028 (Expected)</p>
            <p class="cv-faint mt-2 text-xs italic">Secondary: Air Force Comp. School (2016–2022)</p>
          </div>
        </section>

        <section>
          <h2 class="cv-eyebrow">Technical Skills</h2>
          <div class="mt-3 space-y-4">
            <div>
              <h3 class="cv-muted mb-2 text-sm font-semibold">Languages</h3>
              <div class="flex flex-wrap gap-2">
                {languages.map((s) => <span class="chip">{s}</span>)}
              </div>
            </div>
            <div>
              <h3 class="cv-muted mb-2 text-sm font-semibold">Web &amp; Tools</h3>
              <div class="flex flex-wrap gap-2">
                {webTools.map((s) => <span class="chip">{s}</span>)}
              </div>
            </div>
          </div>
        </section>

        <section>
          <h2 class="cv-eyebrow">Soft Skills</h2>
          <ul class="cv-muted mt-3 space-y-1.5 text-sm">
            {softSkills.map((s) => (
              <li><span class="cv-accent" aria-hidden="true">›</span> {s}</li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    <p class="cv-faint mt-12 hidden text-center text-xs print:block">
      References available upon request · {bare(site.socials.github)}
    </p>
  </main>
</Base>

<script is:inline>
  document.getElementById('print-cv')?.addEventListener('click', () => window.print());
</script>

<style>
  /* Screen (dark) colours — flipped to light under @media print below. */
  .cv-ink { color: var(--color-ink); }
  .cv-muted { color: var(--color-muted); }
  .cv-faint { color: var(--color-faint); }
  .cv-accent { color: var(--color-crimson-link); }
  .cv-line { border-color: var(--color-line); }
  .cv-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-crimson-link);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.5rem;
  }

  @media print {
    /* Clean ink-on-white résumé: neutralise the dark theme + atmosphere. */
    :global(html) { scrollbar-width: auto; }
    :global(body) { background: #fff !important; color: #111 !important; }
    :global(body::after) { display: none !important; } /* kill film grain */
    .no-print { display: none !important; }

    .cv-ink, .cv :is(h1, h2, h3, strong) { color: #111 !important; }
    .cv-muted { color: #3f3f3f !important; }
    .cv-faint { color: #6b6b6b !important; }
    .cv-accent { color: #8c1c2b !important; }
    .cv-line, .cv-eyebrow { border-color: #d8d8d8 !important; }
    .cv-eyebrow { color: #8c1c2b !important; }
    .text-crimson { color: #8c1c2b !important; }

    /* Chips → light bordered tags. */
    .cv :global(.chip) {
      color: #333 !important;
      border-color: #cfcfcf !important;
    }
    main { padding-bottom: 0 !important; }
  }
</style>
