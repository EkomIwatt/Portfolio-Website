---
import { site, navLinks } from '../data/site';
const base = import.meta.env.BASE_URL;
---

<header class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <nav
    class="flex w-full max-w-3xl items-center justify-between gap-4 border border-line bg-base/70 py-2 pl-5 pr-2 backdrop-blur-md"
    aria-label="Primary"
  >
    <!-- Logo: ekom. with the signature crimson period -->
    <a href={base} class="shrink-0 text-base font-semibold tracking-tight text-ink">
      {site.logo}<span class="text-crimson">.</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-6 md:flex">
      {navLinks.map((l) => (
        <li>
          <a
            href={l.href}
            class="group font-mono text-xs uppercase tracking-[0.12em] text-muted transition-colors hover:text-ink"
          >
            <span class="text-crimson/60 group-hover:text-crimson">{l.num}</span>
            <span class="ml-1">{l.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a href="#contact" class="btn btn-shine btn-sm hidden sm:inline-flex">
        Let's talk <span aria-hidden="true">→</span>
      </a>

      <!-- Mobile menu: zero-JS disclosure -->
      <details class="relative md:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center border border-line text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
          </svg>
        </summary>
        <ul class="absolute right-0 mt-3 w-52 space-y-1 border border-line bg-card p-2 shadow-xl">
          {navLinks.map((l) => (
            <li>
              <a href={l.href} class="flex items-center gap-2 px-3 py-2 font-mono text-xs uppercase tracking-[0.12em] text-muted hover:bg-elevated hover:text-ink">
                <span class="text-crimson">{l.num}</span>{l.label}
              </a>
            </li>
          ))}
          <li>
            <a href="#contact" class="btn btn-shine btn-sm mt-1 w-full justify-center">
              Let's talk →
            </a>
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>
