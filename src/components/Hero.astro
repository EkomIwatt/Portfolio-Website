---
import { Image } from 'astro:assets';
import CrimsonField from './CrimsonField.tsx';
import { hero, site } from '../data/site';
import portrait from '../assets/portraits/OTOG9751-Edit.jpg';
---

<section class="relative overflow-hidden px-6 pt-36 pb-20 sm:pt-44 md:pb-28">
  <!-- Animated crimson aurora (raw WebGL island) -->
  <div class="pointer-events-none absolute inset-0 opacity-75">
    <CrimsonField client:visible />
  </div>
  <!-- Light left-side darkening (keeps headline legible) + bottom fade -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-base via-base/40 to-transparent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-base to-transparent" aria-hidden="true"></div>
  <!-- Soft pulsing crimson glow, top-left (gentle, sits over the aurora) -->
  <div
    class="animate-pulse-glow pointer-events-none absolute -top-28 -left-24 h-[480px] w-[600px] rounded-full blur-3xl"
    style="background: radial-gradient(closest-side, color-mix(in srgb, var(--color-crimson) 15%, transparent), transparent);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-12">
    <!-- Statement -->
    <div class="md:col-span-7">
      <p class="animate-rise font-mono text-xs uppercase tracking-[0.18em] text-muted" style="animation-delay:.05s">
        <span class="text-crimson-link">/</span> {hero.eyebrow}
      </p>

      <h1
        class="animate-rise mt-6 text-5xl font-semibold leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl"
        style="animation-delay:.12s"
      >
        {hero.headline.lead}{' '}
        <span class="font-serif italic text-crimson">{hero.headline.accent}</span>{hero.headline.tail}<span class="text-crimson">.</span>
      </h1>

      <p class="animate-rise mt-6 max-w-xl text-lg leading-relaxed text-muted" style="animation-delay:.2s">
        {hero.sub}
      </p>

      <div class="animate-rise mt-8 flex flex-wrap items-center gap-3" style="animation-delay:.28s">
        <a href={hero.ctas.primary.href} class="btn btn-shine">
          {hero.ctas.primary.label} <span aria-hidden="true">→</span>
        </a>
        <a href={hero.ctas.secondary.href} class="btn btn-ghost">
          <span class="h-1.5 w-1.5 shrink-0 bg-crimson" aria-hidden="true"></span>
          {hero.ctas.secondary.label}
        </a>
      </div>

      <!-- Spec line -->
      <dl class="animate-rise mt-12 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-6 font-mono text-xs" style="animation-delay:.36s">
        {hero.spec.map((s) => (
          <div class="flex items-center gap-2">
            <dt class="uppercase tracking-[0.12em] text-faint">{s.k}</dt>
            <dd class="text-ink">{s.v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Portrait -->
    <div class="animate-rise md:col-span-5" style="animation-delay:.22s">
      <figure class="u-glow relative mx-auto max-w-sm">
        <div class="overflow-hidden border border-line bg-card">
          <Image
            src={portrait}
            alt={`Portrait of ${site.name}`}
            width={760}
            densities={[1, 2]}
            class="h-auto w-full object-cover"
          />
        </div>
        <figcaption class="absolute bottom-3 left-3 border border-line bg-base/80 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-muted backdrop-blur">
          {site.role} · {site.location}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
