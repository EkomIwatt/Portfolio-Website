---
import SectionHeading from '../SectionHeading.astro';
import { metrics } from '../../data/sections';
---

<section id="proof" class="relative overflow-hidden px-6 py-24 sm:py-32">
  <div class="bg-dotgrid pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-6xl">
    <SectionHeading num="03" label="By the Numbers" lead="Proof, not" accent="promises" />

    <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden border border-line bg-line lg:grid-cols-4">
      {metrics.map((m) => (
        <div class="bg-base p-8">
          <dt class="font-mono text-xs uppercase tracking-[0.14em] text-muted">{m.label}</dt>
          <dd class="mt-3 text-5xl font-semibold tracking-tight text-crimson sm:text-6xl">{m.value}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-6 font-mono text-xs text-faint">/ figures update as projects ship</p>
  </div>
</section>
