---
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import { projects } from '../../data/sections';
const base = import.meta.env.BASE_URL;
const total = String(projects.length).padStart(2, '0');
---

<section id="work" class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHeading num="01" label="Selected Work" lead="What I've" accent="built" />

    <!-- Sticky-stack: each card pins below the nav and the next slides up over it.
         Pure CSS (position: sticky). Desktop only; cards flow normally on mobile. -->
    <div class="mt-12 space-y-6 md:space-y-0">
      {projects.map((p, i) => (
        <article
          class="overflow-hidden border border-line bg-card md:sticky"
          style={`top: calc(6.5rem + ${i * 1.25}rem)`}
        >
          <div class="grid md:grid-cols-2">
            <!-- Real screenshot when present, else an abstract themed placeholder -->
            <div class="relative min-h-52 overflow-hidden border-b border-line md:min-h-[26rem] md:border-b-0 md:border-r">
              {p.image ? (
                <Fragment>
                  <div class="bg-dotgrid absolute inset-0 opacity-40" aria-hidden="true"></div>
                  <div
                    class="pointer-events-none absolute inset-0"
                    style="background: radial-gradient(70% 70% at 50% 30%, color-mix(in srgb, var(--color-crimson) 16%, transparent), transparent 70%);"
                    aria-hidden="true"
                  ></div>
                  <Image
                    src={p.image}
                    alt={`Screenshot of ${p.name}`}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    class="absolute inset-6 rounded-lg border border-line-strong object-cover object-top shadow-2xl sm:inset-10"
                  />
                </Fragment>
              ) : (
                <Fragment>
                  <div class="bg-dotgrid absolute inset-0 opacity-50" aria-hidden="true"></div>
                  <div
                    class="pointer-events-none absolute inset-0"
                    style="background: radial-gradient(60% 60% at 30% 30%, color-mix(in srgb, var(--color-crimson) 22%, transparent), transparent 70%);"
                    aria-hidden="true"
                  ></div>
                  <div class="relative flex h-full items-center justify-center p-8">
                    <span class="font-mono text-7xl font-semibold text-crimson/40 sm:text-8xl">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                  </div>
                </Fragment>
              )}
            </div>

            <!-- Content -->
            <div class="flex flex-col justify-between p-8 md:p-10">
              <div>
                <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">
                  [{String(i + 1).padStart(2, '0')} <span class="text-faint">/</span> {total}]
                </p>
                <h3 class="mt-4 flex flex-wrap items-center gap-3 text-3xl font-semibold tracking-tight sm:text-4xl">
                  {p.name}
                  {p.wip && <span class="chip chip-wip">In progress</span>}
                </h3>
                <p class="mt-3 max-w-md text-muted">{p.blurb}</p>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {p.tags.map((t) => <li class="chip">{t}</li>)}
                </ul>
              </div>
              <a href={p.href} class="group mt-8 inline-flex items-center gap-2 font-mono text-sm text-crimson-link">
                {p.cta ?? 'View project'}
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 flex justify-center">
      <!-- PLACEHOLDER: /projects catalogue page built later -->
      <a href={`${base}/projects`} class="btn btn-shine">
        See full catalogue <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
