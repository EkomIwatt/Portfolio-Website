---
import SectionHeading from '../SectionHeading.astro';
import CertStack from '../CertStack.tsx';
import { certificates } from '../../data/sections';
---

<section id="certificates" class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHeading num="07" label="Certificates & Awards" lead="Credentials, on" accent="record" />
    <p class="mt-4 max-w-md font-mono text-xs text-faint">/ use the arrows or ← → keys</p>

    <div class="mt-12">
      <CertStack certificates={certificates} client:visible />
    </div>
  </div>
</section>
