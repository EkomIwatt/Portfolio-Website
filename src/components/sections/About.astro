---
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import { about } from '../../data/sections';
import { site } from '../../data/site';
import portrait from '../../assets/portraits/OTOG9742-Edit.jpg';
import Weave from '../Weave.astro';
---

<section id="about" class="relative isolate overflow-clip px-6 py-24 sm:py-32">
  <Weave />

  <div class="relative z-10 mx-auto grid max-w-6xl gap-12 md:grid-cols-12 md:items-center">
    <div class="md:col-span-5">
      <figure class="reveal u-glow relative mx-auto max-w-sm">
        <div class="overflow-hidden border border-line bg-card">
          <Image src={portrait} alt={`Portrait of ${site.name}`} width={760} densities={[1, 2]} class="h-auto w-full object-cover" />
        </div>
      </figure>
    </div>

    <div class="md:col-span-7">
      <SectionHeading num="05" label="About" lead={about.lead} accent={about.accent} tail={about.tail} />
      <div class="reveal mt-6 space-y-4 text-lg leading-relaxed text-muted" style="--reveal-delay: 100ms">
        {about.body.map((p) => <p>{p}</p>)}
      </div>
      <dl class="reveal mt-8 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-6 font-mono text-xs" style="--reveal-delay: 200ms">
        <div class="flex items-center gap-2"><dt class="uppercase tracking-[0.12em] text-faint">Role</dt><dd class="text-ink">{site.role}</dd></div>
        <div class="flex items-center gap-2"><dt class="uppercase tracking-[0.12em] text-faint">Based</dt><dd class="text-ink">{site.location}</dd></div>
        <div class="flex items-center gap-2"><dt class="uppercase tracking-[0.12em] text-faint">Status</dt><dd class="text-crimson-link">{site.status}</dd></div>
      </dl>
    </div>
  </div>
</section>
