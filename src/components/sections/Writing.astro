---
import SectionHeading from '../SectionHeading.astro';
import { posts } from '../../data/sections';
---

<section id="writing" class="bg-surface px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHeading num="08" label="Writing" lead="Notes from the" accent="build" />

    <ul class="mt-12 grid gap-px overflow-hidden border border-line bg-line md:grid-cols-2">
      {posts.map((p) => (
        <li>
          <a href={p.href} class="group flex h-full flex-col justify-between gap-6 bg-base p-8 transition-colors hover:bg-card/40">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">{p.date}</p>
              <h3 class="mt-3 text-2xl font-semibold tracking-tight text-ink transition-colors group-hover:text-crimson">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.excerpt}</p>
            </div>
            <span class="font-mono text-xs text-crimson-link">Read <span class="transition-transform group-hover:translate-x-1 inline-block" aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
