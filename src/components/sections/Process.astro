---
import SectionHeading from '../SectionHeading.astro';
import { process } from '../../data/sections';
---

<section id="process" class="bg-surface px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHeading num="02" label="How I Build" lead="From idea to" accent="shipped" />

    <ol class="mt-12 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {process.map((s) => (
        <li class="bg-base p-6">
          <span class="font-mono text-sm text-crimson">{s.num}</span>
          <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
